#ifndef __RANDOM__
#define __RANDOM__
#include <stddef.h>
#include <stdint.h>
#include <limits>
namespace std {

    template<class UIntType, size_t w, size_t n, size_t m, size_t r,
        UIntType a, size_t u, UIntType d, size_t s,
        UIntType b, size_t t, UIntType c, size_t l, UIntType f>
    class mersenne_twister_engine {
    private:
        UIntType mt[n];
        size_t index;
        static constexpr UIntType mask = (UIntType)-1 >> (sizeof(UIntType) * 8 - w);
        void twist() {
            static constexpr UIntType low_mask = ((UIntType)1 << r) - 1;
            static constexpr UIntType high_mask = mask - low_mask;
            for (size_t i = 0; i < n; i++) {
                UIntType x = (mt[i] & high_mask) | (mt[(i + 1) % n] & low_mask);
                UIntType lx = x >> 1;
                if (x & 1) lx ^= a;
                mt[i] = mt[(i + m) % n] ^ lx;
            }
            index = 0;
        }
    public:
        typedef UIntType result_type;
        static constexpr result_type default_seed = 5489u;

        explicit mersenne_twister_engine(UIntType value = default_seed) {
            seed(value);
        }
        void seed(UIntType value = default_seed) {
            mt[0] = value & mask;
            for (size_t i = 1; i < n; i++) {
                mt[i] = (f * (mt[i - 1] ^ (mt[i - 1] >> (w - 2))) + i) & mask;
            }
            index = n;
        }
        static constexpr UIntType min() { return 0; }
        static constexpr UIntType max() { return mask; }
        UIntType operator()() {
            if (index >= n) twist();
            result_type y = mt[index++];
            y ^= (y >> u) & d;
            y ^= (y << s) & b;
            y ^= (y << t) & c;
            y ^= y >> l;
            return y;
        }
        void discard(unsigned long long z) {
            while (z--) (*this)();
        }
    };
    typedef mersenne_twister_engine<uint_fast32_t,
        32, 624, 397, 31,
        0x9908b0dfUL, 11, 0xffffffffUL, 7,
        0x9d2c5680UL, 15, 0xefc60000UL, 18,
        1812433253UL> mt19937;

    typedef mersenne_twister_engine<uint_fast64_t,
        64, 312, 156, 31,
        0xb5026f5aa96619e9ULL, 29, 0x5555555555555555ULL, 17,
        0x71d67fffeda60000ULL, 37, 0xfff7eee000000000ULL, 43,
        6364136223846793005ULL> mt19937_64;
    template<class RealType, size_t bits, class URBG>
    RealType generate_canonical(URBG& g) {
        constexpr size_t Rm1 = g.max() - g.min();
        constexpr size_t b = (bits < numeric_limits<RealType>::digits ? bits : numeric_limits<RealType>::digits) == 0 ? 1 : (bits < numeric_limits<RealType>::digits ? bits : numeric_limits<RealType>::digits);
#if __cplusplus >= 201703L
        constexpr RealType scale = []() -> RealType {
            RealType r = 1;
            for (size_t i = 0; i < b; i++) r /= 2;
            return r;
            }();
#else
        RealType scale = 1;
        for (size_t i = 0; i < b; i++) scale /= 2;
#endif
#ifndef _USING_DIVIDE_RANDOM
#if __cplusplus >= 201703L
        if constexpr ((Rm1 & (Rm1 + 1)) == 0) {
#else
        if ((Rm1 & (Rm1 + 1)) == 0) {
#endif
            constexpr size_t w = Rm1 ? 64 - __builtin_clzll(Rm1) : 0;
            constexpr size_t k = (b + w - 1) / w < 1 ? 1 : (b + w - 1) / w;
            constexpr size_t drop = k * w - b;

            size_t acc = (g() - g.min()) >> drop;
            if (k > 1)
                for (size_t i = 1; i < k; i++)
                    acc = (acc << w) | (g() - g.min());
            return (RealType)acc * scale;
        }
        else
#endif
        {
            constexpr size_t log2r = 63 - __builtin_clzll(Rm1) == 0 ? 1 : 63 - __builtin_clzll(Rm1);
            constexpr size_t k = (b + log2r - 1) / log2r < 1 ? 1 : (b + log2r - 1) / log2r;
            RealType result = 0;
            for (size_t i = 0; i < k; i++) {
				result = (result + (RealType)(g() - g.min())) / ((RealType)Rm1 + 1);
            }
            if (result >= (RealType)1) result = (RealType)1 - scale;
            return result;
        }
    }
	template <class RealType = double>
    class uniform_real_distribution {
    public:
        class param_type {
        private:
            RealType _a;
            RealType _b;
        public:
            typedef uniform_real_distribution<RealType> distribution_type;
			explicit param_type(RealType a = RealType(0.0), RealType b = RealType(1.0)) : _a(a), _b(b) {}
			RealType a() const { return _a; }
			RealType b() const { return _b; }
            bool operator==(const param_type& p) const {
				return p._a == _a && p._b == _b;
            }
            bool operator!=(const param_type& p) const {
				return !(operator==(p));
            }
        };
    private:
        param_type _param;
    public:
        typedef RealType result_type;

        explicit uniform_real_distribution(RealType a = RealType(0), RealType b = RealType(1)) : _param(a, b) {}
		explicit uniform_real_distribution(const param_type& p) : _param(p.a(), p.b()) {}
        RealType a() const {
            return _param.a();
        }
        RealType b() const {
			return _param.b();
        }
        param_type param() const {
            return _param;
        }
        void param(const param_type& p) {
			_param = p;
        }
        result_type min() const {
			return _param.a();
        }
        result_type max() const {
			return _param.b();
        }
        void reset() {}
        template<class URBG> result_type operator()(URBG& g, const param_type& p) {
			return generate_canonical<RealType, numeric_limits<RealType>::digits, URBG>(g)* (p.b() - p.a()) + p.a();
        }
        template<class URBG> result_type operator()(URBG& g) {
            return operator()<URBG>(g, _param);
        }
        bool operator==(const uniform_real_distribution& d) const {
			return _param == d._param;
        }
        bool operator!=(const uniform_real_distribution& d) const {
			return !(operator==(d));
        }
    };
}
#endif // __RANDOM__