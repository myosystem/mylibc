#ifndef __TYPEINFO__
#define __TYPEINFO__
#include <stddef.h>
#include <exception>

namespace std {
    class type_info {
    protected:
        const char* __name;
        explicit type_info(const char* n) : __name(n) {}
    public:
        virtual ~type_info();
        bool operator==(const type_info& rhs) const noexcept {
            return __name == rhs.__name
                || (__name[0] != '*' && __builtin_strcmp(__name, rhs.__name) == 0);
        }
        bool operator!=(const type_info& rhs) const noexcept {
            return !operator==(rhs);
        }
        bool before(const type_info& rhs) const noexcept {
            return (__name[0] == '*' && rhs.__name[0] == '*')
                ? __name < rhs.__name
                : __builtin_strcmp(__name, rhs.__name) < 0;
        }
        const char* name() const noexcept {
            return __name[0] == '*' ? __name + 1 : __name;
        }
        size_t hash_code() const noexcept {
            size_t h = 0xcbf29ce484222325;
            if (*__name == '*') h = (size_t)__name;
            else {
                const char* _n = __name;
                while (*_n) {
                    h = h ^ (unsigned char)*_n;
                    h = h * 0x100000001b3;
                    _n++;
                }
            }
            h ^= h >> 33;
            h *= 0xff51afd7ed558ccd;
            h ^= h >> 33;
            h *= 0xc4ceb9fe1a85ec53;
            h ^= h >> 33;
            return h;
        }
        type_info(const type_info&) = delete;
        type_info& operator=(const type_info&) = delete;
    };

    class bad_cast : public exception {
    public:
        const char* what() const noexcept override { return "std::bad_cast"; }
    };
    class bad_typeid : public exception {
    public:
        const char* what() const noexcept override { return "std::bad_typeid"; }
    };
}
#endif // __TYPEINFO__