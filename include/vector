#ifndef __VECTOR__
#define __VECTOR__
#include <stdint.h>
#include <utility>
#include <iterator>
#include <new>
namespace std {
	template <typename T>
	class vector {
	public:
		vector() : data_(nullptr), size_(0), capacity_(0) {}
		~vector() {
			for (size_t i = 0; i < size_; i++) {
				data_[i].~T();
			}
			operator delete[](data_);
			data_ = nullptr;
			size_ = 0;
			capacity_ = 0;
		}
		void clear() {
			for (size_t i = 0; i < size_; i++) {
				data_[i].~T();
			}
			size_ = 0;
			capacity_ = 0;
			resize();
		}
		void push_back(const T& value) {
			if (size_ == capacity_) {
				resize();
			}
			new (data_ + size_) T(value);
			size_++;
		}
		T& operator[](size_t index) {
			return data_[index];
		}
		const T& operator[](size_t index) const {
			return data_[index];
		}
		size_t size() const { return size_; }
		size_t capacity() const { return capacity_; }
		T* begin() { return data_; }
		T* end() { return data_ + size_; }
		reverse_iterator<T*> rbegin() { return reverse_iterator<T*>(data_ + size_); }
		reverse_iterator<T*> rend() { return reverse_iterator<T*>(data_); }
		reverse_iterator<const T*> crbegin() const { return reverse_iterator<const T*>(data_ + size_); }
		reverse_iterator<const T*> crend()   const { return reverse_iterator<const T*>(data_); }
		T* erase(size_t index) {
			if (index >= size_) return nullptr;
			for (size_t i = index; i < size_ - 1; i++) {
				data_[i].~T();
				new (data_ + i) T(std::move(data_[i + 1]));
			}
			data_[size_ - 1].~T();
			size_--;
			return data_ + index;
		}
		T& front() {
			return data_[0];
		}
		const T& front() const {
			return data_[0];
		}
		T& back() {
			return data_[size_ - 1];
		}
		const T& back() const {
			return data_[size_ - 1];
		}
		bool empty() const {
			return size_ == 0;
		}
	private:
		void resize() {
			size_t new_capacity = capacity_ == 0 ? 1 : capacity_ * 2;
			T* new_data = static_cast<T*>(operator new[](new_capacity * sizeof(T)));
			for (size_t i = 0; i < size_; i++) {
				new (new_data + i) T(std::move(data_[i]));
				data_[i].~T();
			}
			operator delete[](data_);
			data_ = new_data;
			capacity_ = new_capacity;
		}
		T* data_;
		size_t size_;
		size_t capacity_;
	};
}
#endif /*__VECTOR__*/