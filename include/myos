typedef struct {
    uint64_t sender_pid;    // 8 bytes (Explicitly aligned)
    uint32_t type;          // 4 bytes
    uint32_t status;        // 4 bytes (타입 옆에 상태나 플래그를 두어 8바이트 쌍을 맞춤)

    union {
        // 일반적인 정수형 인자들
        struct {
            uint64_t arg[5];
        } params;

        // 공유 메모리나 문자열 처리를 위한 구조
        struct {
            void* addr[3];
            uint64_t size;
            uint64_t flags;
        } memory;

        // 데이터 페이로드 (짧은 메시지 직송용)
        uint8_t raw[40];
    } payload;

    uint64_t timestamp;     // 8 bytes
} __attribute__((packed)) msg_t;
