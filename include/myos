class Font {
protected:
    static constexpr int BEZIER_STEPS = 8;
    static uint16_t swap16(uint16_t v);
    static uint32_t swap32(uint32_t v);
    FILE* f = nullptr; OffsetSubtable header = {};
    uint16_t unitsPerEm = 0, locFormat = 0, numGlyphs = 0; uint32_t locaoffset = 0, glyphIndex = 0;
    int16_t fontXMin = 0, fontYMin = 0;   // head 전역 bbox 최소값 (음수 보정/베이스라인 통일용)
    std::vector<uint16_t> endCodes, startCodes, idRangeOffsets, glyphIdArray; std::vector<int16_t> idDeltas;
    struct GlyphPoint { int x, y; bool onCurve; };
    struct Glyph { GlyphPoint p1, p2, p3; };
    // ── 내부 파이프라인 (문자열 그리기는 draw() 하나로) ──
    uint16_t getGlyphIndex(uint16_t unicode);
    uint32_t getGlyphOffset(uint16_t gi);
    static std::vector<uint8_t> downsample(const bool* src, int srcStride, int srcW, int srcH, int dstW, int dstH);
    bool drawGlyph(uint32_t glyphoffset, uint32_t* bitmap, uint64_t bw, uint64_t bh);
public:
    Font(const char* path);
    ~Font();
    uint16_t getUnitsPerEm() const;
    // text를 buf(w*h, ARGB)에 그림. px=글자 높이(0이면 h), advance=글자당 가로 전진(0이면 px, 모노스페이스),
    // (x,y)=시작 좌상단, color=글자색(0xRRGGBB). '\n'이면 줄바꿈. 안티에일리어싱 알파블렌딩(정수).
    void draw(const char* text, uint32_t* buf, uint64_t w, uint64_t h,
              uint64_t px = 0, uint64_t advance = 0,
              int64_t x = 0, int64_t y = 0, uint32_t color = 0x000000);
};

// ── Window에 문자열을 그려주는 그리기 컨텍스트 (글리프 커버리지 lazy 캐시) ──
class WinDraw {
private:
    Window* win;                   // 그릴 대상 (win->gbuf)
    Font*   font;                  // 폰트 (소유 안 함)
    uint64_t cellW, cellH;         // 글자 셀 크기(px)
    std::vector<uint8_t*> cache;   // [코드포인트] → 커버리지 셀(폭*cellH), nullptr=미로드
    uint8_t* getGlyph(uint32_t cp);   // 필요 시 렌더 후 캐시, 커버리지 반환 (더블폭이면 폭=2*cellW)
public:
    WinDraw(Window* w, Font* f, uint64_t cellW, uint64_t cellH);
    ~WinDraw();
    WinDraw(const WinDraw&) = delete;
    void drawText(int64_t x, int64_t y, const char* text, uint32_t color = 0xFFFFFF);
};

