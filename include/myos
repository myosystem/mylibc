static inline uint64_t pack_u32(uint32_t hi, uint32_t lo) {
    return ((uint64_t)hi << 32) | (uint64_t)lo;
}

static inline uint32_t unpack_hi(uint64_t v) {
    return (uint32_t)(v >> 32);
}

static inline uint32_t unpack_lo(uint64_t v) {
    return (uint32_t)(v & 0xffffffff);
}
